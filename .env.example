# Read by the commands and the container; nothing loads this file automatically.
# Export the variables you need, or pass them with `docker compose --env-file`.

# Optional. Leave MLFLOW_TRACKING_URI unset to use the file-based tracker.
# MLFLOW_TRACKING_URI=http://localhost:5000

# Used by `driftwatch serve` and the container when --name, --registry or --config are not given.
DRIFTWATCH_MODEL_NAME=churn-demo
DRIFTWATCH_REGISTRY_DIR=registry
# DRIFTWATCH_CONFIG=config/default.yaml

# Used by docker-compose.yml for Grafana. Choose your own value.
# GRAFANA_ADMIN_PASSWORD=
